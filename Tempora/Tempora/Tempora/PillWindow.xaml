<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Tempora.PillWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tempora"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Tempora">

    <Grid>
        <StackPanel Orientation="Vertical" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0">
            <TextBlock x:Name="timer"
                       Text="00:00"
                       FontSize="32"
                       HorizontalAlignment="Center"/>
            <Border x:Name="PillExpandContainer" Height="0" Opacity="0" HorizontalAlignment="Center">
                <StackPanel Orientation="Vertical" Spacing="8">
                    <StackPanel x:Name="TimerControlsPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="8">
                        <Button x:Name="StartButton"
                                Style="{ThemeResource DefaultButtonStyle}"
                                Width="30"
                                Height="30"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Click="StartButton_Click">
                            <FontIcon Glyph="&#xF5B0;" FontSize="12"/>
                        </Button>
                        <Button x:Name="PauseButton"
                                Style="{ThemeResource DefaultButtonStyle}"
                                Width="30"
                                Height="30"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Click="PauseButton_Click">
                            <FontIcon Glyph="&#xF8AE;" FontSize="12"/>
                        </Button>
                    </StackPanel>
                    <Button x:Name="StopButton"
                            HorizontalAlignment="Center"
                            Width="70"
                            Click="StopButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xF78A;" FontSize="12"/>
                            <TextBlock Text="Stop" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>

        <Button x:Name="ExitPillModeButton"
                Click="ExitPillModeButton_Click"
                Width="32" Height="32"
                Background="Transparent"
                BorderThickness="0"
                VerticalAlignment="Top" HorizontalAlignment="Left"
                Margin="4,4,0,0"
                ToolTipService.ToolTip="Exit compact mode">
            <FontIcon Glyph="&#xE740;" FontSize="8"/>
        </Button>
    </Grid>

</Window>
