<?xml version="1.0" encoding="utf-8"?>
<Window  
    x:Class="Tempora.MainWindow"  
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"  
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  
    xmlns:local="using:Tempora"  
    xmlns:vm="using:Tempora.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"  
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    mc:Ignorable="d"  
    Title="Tempora">

    <Grid>
        <!-- Timer Layout -->
        <Grid x:Name="TimerLayout" 
              VerticalAlignment="Center" 
              HorizontalAlignment="Center" 
              Width="120">
            <StackPanel Orientation="Vertical" Spacing="8">
                <TextBlock x:Name="timer" 
                           Text="{x:Bind ViewModel.TimerText, Mode=OneWay}" 
                           FontSize="32" 
                           HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Center" 
                            Spacing="8">
                    <Button x:Name="StartButton" 
                            Style="{ThemeResource DefaultButtonStyle}" 
                            Command="{x:Bind ViewModel.StartCommand}">
                        <FontIcon Glyph="&#xF5B0;" FontSize="12"/>
                    </Button>
                    <Button x:Name="PauseButton" 
                            Style="{ThemeResource DefaultButtonStyle}" 
                            Command="{x:Bind ViewModel.PauseCommand}">
                        <FontIcon Glyph="&#xF8AE;" FontSize="12"/>
                    </Button>
                </StackPanel>
                <Button x:Name="StopButton" 
                        HorizontalAlignment="Center"
                        Width="80"
                        Command="{x:Bind ViewModel.StopCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xF78A;" FontSize="12"/>
                        <TextBlock Text="Stop" FontSize="12"/>
                    </StackPanel>
                </Button>
                <ItemsControl x:Name="BreakIndicatorItemsControl" 
                              ItemsSource="{x:Bind ViewModel.BreakIndicators, Mode=OneWay}"
                              HorizontalAlignment="Center" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <StackPanel.ChildrenTransitions>
                                    <TransitionCollection>
                                        <EntranceThemeTransition IsStaggeringEnabled="True" />
                                    </TransitionCollection>
                                </StackPanel.ChildrenTransitions>
                            </StackPanel>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BreakIndicator">
                            <Ellipse Width="10" 
                                     Height="10" 
                                     Stroke="{ThemeResource SystemAccentColorBrush}" 
                                     StrokeThickness="1" 
                                     Margin="2"
                                     Fill="{x:Bind FillBrush, Mode=OneWay}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <!-- Settings Button -->
        <Button PointerEntered="Button_PointerEntered" 
                PointerExited="Button_PointerExited" 
                Width="36" Height="36" 
                x:Name="SettingsButton"
                Click="SettingsButton_Click"
                Background="Transparent"
                BorderThickness="0"
                VerticalAlignment="Bottom" HorizontalAlignment="Left">
            <AnimatedIcon x:Name="SettingsAnimatedIcon">
                <AnimatedIcon.Source>
                    <animatedvisuals:AnimatedSettingsVisualSource/>
                </AnimatedIcon.Source>
                <AnimatedIcon.FallbackIconSource>
                    <SymbolIconSource Symbol="Setting"/>
                </AnimatedIcon.FallbackIconSource>
            </AnimatedIcon>
        </Button>
    </Grid>

</Window>
